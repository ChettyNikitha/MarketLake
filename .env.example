# Kalshi API credentials (never commit real values)
KALSHI_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-key.key
# Alternative to KALSHI_PRIVATE_KEY_PATH: paste the PEM contents directly (use \n for newlines)
KALSHI_PRIVATE_KEY_PEM=

# Kalshi API base URL
KALSHI_BASE_URL=https://demo-api.kalshi.co

# Postgres connection string used by the FastAPI app and the ETL pipeline
DATABASE_URL=postgresql+psycopg2://kalshi:kalshi@postgres:5432/kalshi

# Root directory for the raw/curated data lake
DATA_LAKE_ROOT=./data_lake
